# aftersale-cs 环境变量模板（复制为 .env 后填入真实值，.env 已被 .gitignore 屏蔽，不会入库）
# ---------------------------------------------------------------------------
# 大模型 API Key（DashScope / 阿里百炼 的 Qwen）。变量名沿用 QWEN。
QWEN=你的DashScope_API_Key

# 模型名（OpenAI 兼容模式下的 Qwen 模型，按需替换）
AFTERSALE_MODEL=qwen3.7-plus-2026-05-26

# LLM 调用超时（秒）与重试次数
AFTERSALE_TIMEOUT=120
AFTERSALE_MAX_RETRIES=2

# 循环护栏：主管最大派单轮数（防死循环）
AFTERSALE_MAX_STEP=8

# 人工驳回上限（超过后强制发送）
AFTERSALE_MAX_REJECT=2

# FastAPI 监听地址与端口
AFTERSALE_HOST=0.0.0.0
AFTERSALE_PORT=8000

# 允许跨域的前端源（逗号分隔，开发期可用 *）
AFTERSALE_CORS_ORIGINS=*

# ---- 向量检索（ChromaDB + 多 embedding 后端，见 vector_store.py）----
# 嵌入后端三选一（免注册新平台）：
#   dashscope   : 阿里云百炼 qwen3.7-text-embedding，复用上面的 QWEN key（推荐，默认）
#   siliconflow : SiliconFlow BAAI/bge-m3（需在下面填 SILICONFLOW_API_KEY）
#   local       : sentence-transformers 本地加载模型（免 key，但要下载模型权重）
#   off         : 关闭向量检索，用轻量关键词检索
AFTERSALE_EMBED_BACKEND=dashscope
# 向量维度（仅 qwen3.7-text-embedding 支持 256~2560，默认 1024；bge-m3 固定 1024 忽略此项）
AFTERSALE_EMBED_DIM=1024
# 嵌入模型：dashscope 默认 qwen3.7-text-embedding；siliconflow 默认 BAAI/bge-m3；local 可换其他
AFTERSALE_EMBED_MODEL=
# 仅 backend=siliconflow 时需要（SiliconFlow 平台申请）
SILICONFLOW_API_KEY=
# 向量库持久化目录（已被 .gitignore 屏蔽）
AFTERSALE_VECTOR_DIR=faq_chromadb

# ---- 鉴权（见 auth.py）----
# JWT 签名密钥：生产环境必须改成随机长密钥（>=32 字节）
# 生成：python -c "import secrets;print(secrets.token_hex(32))"
AFTERSALE_JWT_SECRET=dev-secret-change-me-in-production-please-32bytes
# 内置管理员密码（首次启动创建 admin 时生效）
AFTERSALE_ADMIN_PASS=admin123

# ---- 限流（见 rate_limit.py）----
# 每 IP / 每窗口 请求上限
AFTERSALE_IP_RATE_LIMIT=120
# 每用户 / 每窗口 请求上限
AFTERSALE_USER_RATE_LIMIT=30
# 滑动窗口（秒）
AFTERSALE_RATE_WINDOW=60

# ---- 跨进程会话持久化（RedisSaver，多 uvicorn 实例共享 thread_id 状态）----
# backend：memory（单进程内存，默认）| redis（跨进程持久，需 Redis Stack + RediSearch 模块）
AFTERSALE_CHECKPOINTER=memory
# redis 后端时配置（连不上会自动回退 memory，不会阻塞启动）
AFTERSALE_REDIS_HOST=127.0.0.1
AFTERSALE_REDIS_PORT=6379
AFTERSALE_REDIS_DB=0
AFTERSALE_REDIS_PASSWORD=
# 探针：python test_redis_saver.py [host port db password]
# 装真 Redis Stack：docker run -d -p 6379:6379 redis/redis-stack-server:latest
